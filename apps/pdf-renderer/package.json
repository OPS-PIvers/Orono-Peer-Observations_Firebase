{
  "name": "@ops/pdf-renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsx watch src/index.ts",
    "start": "node lib/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t pdf-renderer:dev .",
    "docker:run": "docker run --rm -p 8080:8080 pdf-renderer:dev"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@ops/shared": "workspace:*",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/html": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "hono": "^4.13.14",
    "puppeteer": "^25.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
