{
  "name": "@ops/pdf-renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsx watch src/index.ts",
    "start": "node lib/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t pdf-renderer:dev .",
    "docker:run": "docker run --rm -p 8080:8080 pdf-renderer:dev"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@ops/shared": "workspace:*",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "hono": "^4.13.10",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
