rules_version = '2';

// =============================================================================
// Orono Peer Observations — Firestore Security Rules
// =============================================================================
// Two layers of defense:
//   1) Auth blocking function (functions/src/auth/beforeCreate.ts) rejects
//      sign-ins from outside @orono.k12.mn.us at the Auth boundary.
//   2) These rules re-check the email domain on every request and constrain
//      what each role can read/write based on custom claims.
//
// Custom claims set by the auth flow:
//   request.auth.token.email                — verified email
//   request.auth.token.role                 — professional staff role slug (e.g. "administrator")
//   request.auth.token.hasSpecialAccess     — true for Admin / Peer Eval / Full Access
//   request.auth.token.isAdmin              — true for Administrator/Full Access roles or hasAdminAccess flag
//
// Two admin tiers:
//   isAdmin()        — the claim. Managing observations/windows and, for
//                      building Administrators, their own building's staff.
//   isConsoleAdmin() — Full Access, or the hasAdminAccess staff flag. The
//                      Admin Console's data: roster-wide staff edits, roles,
//                      rubrics, buildings, modules, settings, templates, logs.
//                      A building Administrator is isAdmin() but not this.
//
// Per the migration plan: in v1 admins can edit everything that's currently
// sheet-editable plus a handful of code-locked items. Cloud Functions use
// the Admin SDK which bypasses these rules, so privileged server-side
// operations don't need explicit allows here.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isFromOronoDomain() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@orono[.]k12[.]mn[.]us$');
    }

    function role() {
      return request.auth.token.role;
    }

    function hasSpecialAccess() {
      return isFromOronoDomain() && request.auth.token.hasSpecialAccess == true;
    }

    function isAdmin() {
      return isFromOronoDomain() && request.auth.token.isAdmin == true;
    }

    // Mirrors canOpenAdminConsole in @ops/shared. The claim can't tell an
    // Administrator with hasAdminAccess from one without, so only that case
    // pays for a staff-doc read.
    function isConsoleAdmin() {
      return isAdmin()
        && (role() != 'administrator'
            || staffDocData().get('hasAdminAccess', false) == true);
    }

    // Read-only "view as": console admins, or staff granted canViewAs in the
    // Admin Console, may READ everything a viewed person could (writes are
    // unchanged — the app blocks them while viewing as someone).
    function canReadAll() {
      return isConsoleAdmin()
        || (isFromOronoDomain()
            && staffDocData().get('canViewAs', false) == true
            && staffDocData().get('isActive', true) == true);
    }

    // Demo-edit sessions (View As + Edit): the signed-in user is being
    // driven by someone else via a custom token carrying `demoEditBy`. Such
    // a session may only write demo staff's records; every other write is
    // refused. See DEMO_EDIT_CLAIM in @ops/shared.
    function notDemoEdit() {
      return request.auth == null || request.auth.token.get('demoEditBy', null) == null;
    }
    function isDemoStaff(email) {
      return get(/databases/$(database)/documents/staff/$(email)).data.get('isDemo', false) == true;
    }

    function isBuildingAdmin() {
      return isAdmin() && role() == 'administrator';
    }

    function isCurrentUserEmail(email) {
      return isFromOronoDomain() && request.auth.token.email == email;
    }

    // The requesting staff doc (lowercased-email key matches the token email).
    function staffDocData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data;
    }

    // Does the requester satisfy the given module's autoEnable rule? Mirrors
    // staffMatchesAutoEnable in @ops/shared — keep the two in sync.
    function matchesModuleAutoEnable(moduleId) {
      let auto = get(/databases/$(database)/documents/modules/$(moduleId)).data.get('autoEnable', null);
      let y = staffDocData().get('year', 1);
      let summ = staffDocData().get('summativeYear', false);
      // Stored cycleStatus wins; docs written before it existed fall back to
      // the legacy year/summativeYear derivation (mirrors staffCycleStatus).
      let stored = staffDocData().get('cycleStatus', null);
      let legacy = y >= 4 ? 'probationary' : (summ ? 'high' : (y == 1 ? 'planning' : 'developing'));
      let status = stored in ['planning', 'developing', 'high', 'probationary'] ? stored : legacy;
      let dy = y >= 4 ? y - 3 : y;
      // 'low' is the retired pre-split label, kept readable so modules still
      // pinned to it match both Planning and Developing (mirrors the
      // LEGACY_CYCLE_STATUS branch in staffMatchesAutoEnable). The whole
      // expression stays behind `auto != null` so a manual-only module never
      // dereferences a null rule.
      return auto != null
        && ((auto.dimension == 'status'
             && (auto.value == status
                 || (auto.value == 'low'
                     && (status == 'planning' || status == 'developing'))))
            || (auto.dimension == 'year' && auto.value == dy));
    }

    // Building Administrators (/my-staff) may create and edit staff in
    // their own building(s): never someone holding a special role, never to
    // or from a special role, and only the fields that page writes — so no
    // module or Admin Console access. Moving someone out of the building is
    // allowed; pulling someone in from another building is not.
    function buildingAdminCanWriteStaffData(data) {
      return data.get('buildings', []).hasAny(staffDocData().get('buildings', []))
        && !(data.get('role', '') in ['administrator', 'peer-evaluator', 'full-access']);
    }

    function buildingAdminCanCreateStaff(email) {
      return isBuildingAdmin()
        && request.resource.data.get('email', '') == email
        && buildingAdminCanWriteStaffData(request.resource.data)
        && request.resource.data.get('hasAdminAccess', false) == false
        && request.resource.data.get('canViewAs', false) == false
        && request.resource.data.get('canViewAsEdit', false) == false
        && request.resource.data.get('isDemo', false) == false
        && request.resource.data.get('modules', []).size() == 0;
    }

    function buildingAdminCanUpdateStaff() {
      return isBuildingAdmin()
        && buildingAdminCanWriteStaffData(resource.data)
        && !(request.resource.data.get('role', '') in ['administrator', 'peer-evaluator', 'full-access'])
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'role', 'year', 'buildings', 'cycleStatus', 'summativeYear',
                      'isActive', 'updatedAt']);
    }

    // Building Administrators may only start observations of active,
    // summative (Probationary or High Cycle) staff in one of their own
    // buildings. Mirrors observeBlockReason in @ops/shared; the status
    // derivation mirrors staffCycleStatus like matchesModuleAutoEnable.
    function adminCanObserve(email) {
      let s = get(/databases/$(database)/documents/staff/$(email)).data;
      let y = s.get('year', 1);
      let stored = s.get('cycleStatus', null);
      let legacy = y >= 4 ? 'probationary' : (s.get('summativeYear', false) ? 'high' : (y == 1 ? 'planning' : 'developing'));
      let status = stored in ['planning', 'developing', 'high', 'probationary'] ? stored : legacy;
      return s.get('isActive', true) == true
        && s.get('buildings', []).hasAny(staffDocData().get('buildings', []))
        && status in ['high', 'probationary'];
    }

    function unchanged(field) {
      // Use .get(field, null) so this works even when the field is absent
      // on either side of the update (e.g., finalizedAt on a Draft).
      return resource.data.get(field, null) == request.resource.data.get(field, null);
    }

    // --- Default deny --------------------------------------------------------
    // Anything not explicitly granted below is denied. Always.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- /staff/{email} ------------------------------------------------------
    // Own doc: read only. Console admins: full read/write. Building
    // Administrators: create/update in their building (see
    // buildingAdminCanCreateStaff). Special-access (PE): read all (needed for
    // the filter UI to list potential observees).
    match /staff/{email} {
      // Deliberately NOT readable by every domain user: a staff doc carries
      // sensitive HR-adjacent fields (year/summativeYear evaluation status,
      // hasAdminAccess, emailPreferences), and district emails are
      // predictable enough that a broad `get` would let any teacher pull any
      // colleague's record. The Staff Dashboard's Peer Evaluator card reads
      // the denormalized `observerName` on the observation doc instead.
      allow get: if isCurrentUserEmail(email) || hasSpecialAccess() || canReadAll();
      allow list: if hasSpecialAccess() || canReadAll();
      allow create: if (isConsoleAdmin() || buildingAdminCanCreateStaff(email))
        && notDemoEdit();
      allow update: if (isConsoleAdmin() || buildingAdminCanUpdateStaff())
        && (notDemoEdit() || isDemoStaff(email));
      allow delete: if (isConsoleAdmin())
        && notDemoEdit();

      // Per-staff module completion. The owner reads/writes; admins read.
      match /moduleProgress/{itemId} {
        allow read: if isCurrentUserEmail(email) || isAdmin() || canReadAll();
        allow write: if (isCurrentUserEmail(email) || isConsoleAdmin())
          && notDemoEdit();
      }

      // Evaluator check-offs for dashboard steps not tied to an observation.
      // Read: the staff member (their dashboard) and special access (the
      // evaluator checklist). Written only by the setStepCheck callable
      // (Admin SDK), which re-verifies special access and the step's mode.
      match /stepChecks/{stepId} {
        allow read: if isCurrentUserEmail(email) || hasSpecialAccess() || canReadAll();
        allow write: if false;
      }
    }

    // --- /roles, /rubrics ----------------------------------------------------
    // Read: anyone signed-in from the domain (the client UI needs these to
    // render the rubric for any user). Write: admin only.
    match /roles/{roleId} {
      allow read: if isFromOronoDomain();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
    }

    match /buildings/{buildingId} {
      allow read: if isFromOronoDomain();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
    }

    // --- /modules/{moduleId} -------------------------------------------------
    // Admin-defined participation tracks. Read: anyone signed-in from the
    // domain (clients render module chips + nav). Write: admin only.
    match /modules/{moduleId} {
      allow read: if isFromOronoDomain();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
    }

    // --- module items (collection-group rule) --------------------------------
    // Resource/material content under /modules/{id}/items. Read: admin, OR a
    // signed-in staff member whose /staff doc lists this item's moduleId in
    // its `modules` array. Recursive ({path=**}) so the same rule authorizes
    // both direct gets and the dashboard's collectionGroup('items') query.
    // Write: admin only.
    //
    // Scope note: the only `items` subcollection today is /modules/{id}/items;
    // {path=**} is required for collection-group support. Any future `items`
    // subcollection elsewhere would also match this rule — keep that in mind.
    // Casing note: staff doc IDs are lowercased emails. This get() keys off
    // request.auth.token.email, which Google Workspace returns lowercase; if a
    // token ever carried a mixed-case email the get() would 404 and access
    // would be (safely) denied via the .get('modules', []) default.
    match /{path=**}/items/{itemId} {
      allow read: if isAdmin() || canReadAll()
        || (isFromOronoDomain()
            && (resource.data.moduleId in staffDocData().get('modules', [])
                || matchesModuleAutoEnable(resource.data.moduleId)));
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
    }

    match /rubrics/{rubricId} {
      allow read: if isFromOronoDomain();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
    }

    // --- /roleYearMappings/{mappingId} ---------------------------------------
    // Doc id convention: `${roleId}_${year}` (e.g. "teacher_1").
    match /roleYearMappings/{mappingId} {
      allow read: if isFromOronoDomain();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
    }

    // --- /workProductQuestions ----------------------------------------------
    // Staff need to read questions (for WorkProductAnswerForm / InstructionalRoundAnswerForm).
    // Writes are admin-only.
    // Building Administrators manage their own buildings' Planning /
    // Reflection sets: Standard questions whose setId is building-<id> for a
    // building on their staff doc (see resolveQuestionSetId in @ops/shared).
    match /workProductQuestions/{id} {
      function isBuildingAdmin() {
        return isFromOronoDomain() && role() == 'administrator';
      }
      function inOwnBuildingSet(data) {
        return data.get('type', '') == 'standard'
          && data.get('buildingId', '') is string
          && data.get('buildingId', '').matches('^[a-z0-9-]+$')
          && data.get('setId', '') == 'building-' + data.get('buildingId', '')
          && get(/databases/$(database)/documents/buildings/$(data.get('buildingId', ''))).data.displayName
               in staffDocData().get('buildings', []);
      }

      allow read: if isFromOronoDomain();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
      allow create: if (isBuildingAdmin() && inOwnBuildingSet(request.resource.data))
        && notDemoEdit();
      allow update: if (isBuildingAdmin()
        && inOwnBuildingSet(resource.data)
        && inOwnBuildingSet(request.resource.data))
        && notDemoEdit();
      allow delete: if (isBuildingAdmin() && inOwnBuildingSet(resource.data))
        && notDemoEdit();
    }

    // --- /emailTemplates -----------------------------------------------------
    // Not user-facing. Admins read (the staff page's manual-email menu);
    // console admins edit.
    match /emailTemplates/{id} {
      allow read: if isAdmin() || canReadAll();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
    }

    // --- /observationWindows/{windowId} -------------------------------------
    // A scheduling window. Read: special-access (PE/admin) or an invited
    // staff member (their email is in invitedEmails). Create: special-access,
    // and the observer must be the caller. Update/delete: admin or the
    // observer. Staff never write the window (or its peBusyIntervals /
    // dayCounts) directly — booking + day-preference flow through callable
    // Cloud Functions (Admin SDK), which is what keeps the evaluator-time
    // ledger and per-day caps atomic.
    match /observationWindows/{windowId} {
      allow get, list: if hasSpecialAccess()
        || canReadAll()
        || (isFromOronoDomain() && request.auth.token.email in resource.data.invitedEmails);
      allow create: if (hasSpecialAccess()
        && role() in ['administrator', 'peer-evaluator', 'full-access']
        && request.resource.data.observerEmail == request.auth.token.email
        // Building Administrators' windows book Standard observations only.
        && (role() != 'administrator'
            || request.resource.data.defaultObservationType == 'Standard'))
        && notDemoEdit();
      // Delete: admin or the observer. Unchanged.
      allow delete: if (isAdmin()
        || (isFromOronoDomain() && resource.data.observerEmail == request.auth.token.email))
        && notDemoEdit();
      // Update: admin may change anything. The observer may only touch a small
      // set of cosmetic/booking-default fields on their own window. The
      // authoritative accounting/invite/status fields (invitedEmails, invitees,
      // peBusyIntervals, dayCounts, perDayCap, status, the window bounds, etc.)
      // are mutated only inside callable Cloud Functions (Admin SDK, which
      // bypasses these rules) — the web client never writes the window doc
      // directly, so this allowlist can't break any legitimate client flow.
      allow update: if (isAdmin()
        || (
          isFromOronoDomain()
          && resource.data.observerEmail == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'defaultObservationName',
                'calendarEventTitle',
                'calendarEventDescription',
                'gcalSendUpdates',
                'updatedAt'
              ])
        ))
        && notDemoEdit();

      // Slots: readable by anyone who can read the parent window; never
      // client-writable (mutated only inside the booking transaction).
      match /slots/{slotId} {
        allow read: if hasSpecialAccess() || canReadAll()
          || (isFromOronoDomain()
              && request.auth.token.email in
                 get(/databases/$(database)/documents/observationWindows/$(windowId)).data.invitedEmails);
        allow write: if false;
      }

      // Day-preference submissions: readable by the owner, the observer, or
      // an admin. Submitted via callable so day-cap accounting stays atomic.
      match /preferences/{prefEmail} {
        allow read: if hasSpecialAccess() || canReadAll()
          || isCurrentUserEmail(prefEmail)
          || (isFromOronoDomain()
              && request.auth.token.email ==
                 get(/databases/$(database)/documents/observationWindows/$(windowId)).data.observerEmail);
        allow write: if false;
      }
    }

    // --- /buildingSchedules/{buildingId} ------------------------------------
    // Bell schedules drive the booking calendar. The booking UI needs to read
    // period names/times, so anyone signed-in from the domain may read.
    // Writes are admin-only (Admin Console → Building schedule editor).
    match /buildingSchedules/{buildingId} {
      allow read: if isFromOronoDomain();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();

      // Archived year snapshots + the staged next-year draft ("Prepare next
      // year" flow on the Building schedule editor). Slot generation and the
      // booking UI only ever read the live parent doc, so these are
      // admin-only in both directions.
      match /versions/{versionId} {
        allow read: if canReadAll();
        allow write: if (isConsoleAdmin())
          && notDemoEdit();
      }
    }

    // --- /signupFields/{fieldId} --------------------------------------------
    // Admin-defined detail fields staff fill in when booking. Read for anyone
    // signed-in (the booking form renders them); write admin-only.
    match /signupFields/{fieldId} {
      allow read: if isFromOronoDomain();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
    }

    // --- /appSettings --------------------------------------------------------
    // Branding and a few public-ish flags need to be readable by everyone
    // signed in (for app name, logo, banner). Writes are admin-only.
    match /appSettings/{id} {
      allow read: if isFromOronoDomain();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
    }

    // --- /observations/{observationId} --------------------------------------
    //
    // Read:
    //   - observer (creator) of the observation
    //   - observed staff member, ONLY if status == 'Finalized'
    //   - any user with special access (admin / PE / full access)
    //
    // Create: observer roles only (administrator / peer-evaluator /
    // full-access — canCreateObservations in @ops/shared). hasSpecialAccess
    // alone isn't enough: the hasAdminAccess staff flag grants it to people
    // whose own role is observed (e.g. a specialist with Admin Console access).
    //
    // Update:
    //   - admin: any field
    //   - observer + currently Draft: only the autosave-editable fields
    //     (allowlisted via diff().affectedKeys().hasOnly(...)). status,
    //     participant identity, type, timestamps, and scheduling linkage are
    //     immutable here. The Draft → Finalized transition happens server-side
    //     via a callable (it also renders the PDF, shares the Drive folder,
    //     sends email, etc.).
    //   - observed staff: workProductAnswers on their own observation (any
    //     type, Draft or Finalized), or the ack fields on a Finalized
    //     observation (must stamp their own email).
    //
    // Delete: admin, or the observer while the observation is still a Draft.
    match /observations/{observationId} {
      // Ownership model (mirrors observationAccess in @ops/shared):
      //   owner       — the observer who created it: full control of a Draft.
      //   co-observer — listed in coObserverEmails by the owner (e.g. a
      //                 principal and associate principal observing
      //                 together): read, and edit the Draft's content.
      //   oversight   — console admins (Full Access, or the hasAdminAccess
      //                 staff flag): everything, including finalized docs.
      // Peer Evaluators and building Administrators see nothing they don't
      // own or co-observe.
      function ownsObs() {
        return isCurrentUserEmail(resource.data.observerEmail);
      }
      function coObservesObs() {
        return isFromOronoDomain()
          && request.auth.token.email in resource.data.get('coObserverEmails', []);
      }
      function isObservedObs() {
        return isCurrentUserEmail(resource.data.observedEmail);
      }
      // Content an observer edits on a Draft. The autosave in
      // ObservationEditorPage writes exactly these fields (see its setDoc
      // merge payload); evidence/audio/componentTags/driveFolderId are
      // written server-side via callables (Admin SDK). hasOnly therefore
      // blocks any change to type, observedEmail, observerEmail,
      // observedName/Role/Year, status, createdAt, finalizedAt, the
      // scheduling linkage, or injected/arbitrary fields.
      function draftContentKeys() {
        return [
          'observationData',
          'componentNotes',
          'scriptDoc',
          'observationName',
          'observationDate',
          'preObsDate',
          'preObsNotes',
          'postObsDate',
          'postObsNotes',
          'lastModifiedAt'
        ];
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      allow get: if ownsObs() || isObservedObs() || coObservesObs() || canReadAll();
      // Rules aren't filters: an observer's queries must constrain
      // observerEmail == me or coObserverEmails array-contains me.
      allow list: if ownsObs() || isObservedObs() || coObservesObs() || canReadAll();

      allow create: if (hasSpecialAccess()
        && role() in ['administrator', 'peer-evaluator', 'full-access']
        && request.resource.data.observerEmail == request.auth.token.email
        && request.resource.data.status == 'Draft'
        && request.resource.data.get('coObserverEmails', []).size() == 0
        // Building Administrators run Standard observations only. Mirrors
        // creatableObservationTypes() in @ops/shared.
        && (role() != 'administrator' || request.resource.data.type == 'Standard')
        // ...and only of staff they can observe (see adminCanObserve).
        && (role() != 'administrator' || adminCanObserve(request.resource.data.observedEmail)))
        && (notDemoEdit() || isDemoStaff(request.resource.data.observedEmail));

      allow update: if ((
          // Owner: Draft content, the teacher-visibility switchboard and who
          // co-observes. The owner can't add themselves or the observed
          // teacher as a co-observer.
          ownsObs()
          && resource.data.status == 'Draft'
          && changedKeys().hasOnly(draftContentKeys().concat(['draftVisibility', 'coObserverEmails']))
          && !(request.auth.token.email in request.resource.data.get('coObserverEmails', []))
          && !(resource.data.observedEmail in request.resource.data.get('coObserverEmails', []))
          && request.resource.data.get('coObserverEmails', []).size() <= 10
        )
        || (
          // Co-observer: Draft content only — not sharing or visibility.
          coObservesObs()
          && resource.data.status == 'Draft'
          && changedKeys().hasOnly(draftContentKeys())
        )
        || (
          // Observed staff answering their Planning / Reflection questions.
          // Every observation type carries questions (Standard included).
          // Allowed on Finalized too: Reflection stays open after finalize
          // (the evaluator may finalize before the teacher has reflected),
          // and rules cannot tell which array entries changed, so the UI —
          // not this rule — keeps Planning read-only once finalized and
          // flags any answer saved after finalizedAt.
          isObservedObs()
          && resource.data.status in ['Draft', 'Finalized']
          && changedKeys().hasOnly(['workProductAnswers', 'lastModifiedAt'])
        )
        || (
          // Observed staff acknowledging their finalized observation — can
          // only touch the two ack fields plus the audit timestamp, and must
          // stamp acknowledgedBy with their own (verified) email so the
          // acknowledgement can't be attributed to someone else.
          isObservedObs()
          && resource.data.status == 'Finalized'
          && request.resource.data.acknowledgedBy == request.auth.token.email
          && changedKeys().hasOnly(['acknowledgedAt', 'acknowledgedBy', 'lastModifiedAt'])
        )
        // Oversight can correct anything except who was observed.
        || (isConsoleAdmin() && unchanged('observedEmail')))
        && (notDemoEdit() || isDemoStaff(resource.data.observedEmail));

      allow delete: if ((ownsObs() && resource.data.status == 'Draft') || isConsoleAdmin())
        && (notDemoEdit() || isDemoStaff(resource.data.observedEmail));

      // Evaluator check-offs for dashboard steps tied to this observation.
      // Read: special access, or the observed staff member (any status —
      // their dashboard shows the check). Written only by the setStepCheck
      // callable (Admin SDK); no client writes, including admins.
      match /stepChecks/{stepId} {
        allow read: if canReadAll()
          || isCurrentUserEmail(
               get(/databases/$(database)/documents/observations/$(observationId)).data.observedEmail)
          || isCurrentUserEmail(
               get(/databases/$(database)/documents/observations/$(observationId)).data.observerEmail)
          || (isFromOronoDomain() && request.auth.token.email in
               get(/databases/$(database)/documents/observations/$(observationId)).data.get('coObserverEmails', []));
        allow write: if false;
      }
    }

    // --- /userCalendarTokens/{email} ----------------------------------------
    // Per-user Google Calendar OAuth credentials. Server-only — refresh
    // tokens never leave the backend. Cloud Functions use the Admin SDK
    // (which bypasses rules); clients are denied entirely.
    match /userCalendarTokens/{email} {
      allow read, write: if false;
    }

    // --- /rateLimitCounters/{id} --------------------------------------------
    // Per-user fixed-window rate-limit counters (see
    // functions/src/lib/rateLimit.ts). Server-only — Cloud Functions use the
    // Admin SDK (which bypasses these rules); clients are denied entirely.
    // Redundant with the default-deny above, but explicit for parity with the
    // other server-only collections.
    match /rateLimitCounters/{id} {
      allow read, write: if false;
    }

    // --- /auditLog -----------------------------------------------------------
    // Read: console admin only. No client ever writes — Cloud Functions use admin SDK.
    match /auditLog/{id} {
      allow read: if isConsoleAdmin();
      allow write: if false;
    }

    // --- /transcriptionJobs --------------------------------------------------
    // Read: the requester and console admins. Writes are server-only.
    match /transcriptionJobs/{id} {
      allow get: if canReadAll()
        || isCurrentUserEmail(resource.data.requestedBy);
      allow list: if canReadAll()
        || isCurrentUserEmail(resource.data.requestedBy);
      allow write: if false;
    }

    // --- /mail ---------------------------------------------------------------
    // Trigger Email extension writes and reads via admin SDK — clients must
    // never write here directly (that would bypass template rendering and
    // audit logging).
    match /mail/{document} {
      allow read, write: if false;
    }

    // --- /dashboardQuickMaterials/{id} --------------------------------------
    // Single "global" doc holding the right-rail quick-materials list. Read
    // for everyone signed-in; write for admin only (Admin Console →
    // Dashboard surface).
    match /dashboardQuickMaterials/{id} {
      allow read: if isFromOronoDomain();
      allow write: if (isConsoleAdmin())
        && notDemoEdit();
    }

    // The dashboard feature config doc lives at /appSettings/dashboard and
    // is covered by the /appSettings rule above (everyone reads, admin
    // writes) — no separate match needed.
  }
}
