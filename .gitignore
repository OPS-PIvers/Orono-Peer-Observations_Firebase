# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
apps/functions/lib/
apps/pdf-renderer/lib/
packages/shared/dist/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
!.env.example

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
*.local

# Emulator data (we keep ./fixtures/seed but not ephemeral runtime exports)
.emulator-data/

# Firestore data exports (scripts/export) — contain staff/observation PII,
# never commit
exports/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Google Drive for Desktop upload staging (recreated automatically)
.tmp.driveupload/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
playwright-report/
test-results/

# Cloud Run
apps/pdf-renderer/.gcloudignore

# Service-account keys — NEVER commit
*-credentials.json
*service-account*.json
secrets/
# google-github-actions/auth writes the key here; gcloud builds submit
# derives its ignore list from this file, so this also keeps it out of
# the Cloud Build source upload.
gha-creds-*.json

# Vite
*.local

# Impeccable design-skill transient state (detector cache, live-server handle)
**/.impeccable/hook.cache.json
**/.impeccable/live/
