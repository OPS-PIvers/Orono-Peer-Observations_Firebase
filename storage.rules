rules_version = '2';

// Storage is intentionally minimal — primary blob storage is Google Drive
// (via service account + Domain-Wide Delegation). Any file we do put in
// Cloud Storage goes under /admin-uploads/.
//
// Two sub-paths, different read scopes:
//   - /admin-uploads/branding/**  — app branding logo/icon fallbacks. Written
//     by admins; read by any signed-in district user with a verified,
//     trusted email (the app fetches them via the SDK for logged-in chrome;
//     they are ALSO served publicly via their tokenized download URL, which
//     bypasses these rules entirely, so the read check here is
//     belt-and-suspenders).
//   - everything else under /admin-uploads/ — any other admin staging (e.g.
//     temp uploads pre-Drive transfer, which can hold staff PII). Admin-only
//     for BOTH read and write so a signed-in non-admin can't read or list
//     another user's sensitive uploads.
//
// isConsoleAdmin = the isAdmin custom claim minus building Administrators,
// who hold the claim for observation work but don't get the Admin Console
// (see isConsoleAdmin in firestore.rules). Storage rules can't cheaply read
// the staff doc, so an Administrator who also has hasAdminAccess can't upload
// here either; a Full Access or other hasAdminAccess user can.
//
// A View As + Edit session (custom token carrying `demoEditBy`) never passes:
// it keeps the account's isAdmin/role claims, so a Peer Evaluator with console
// access would otherwise get admin-uploads read/write. Mirrors notDemoEdit()
// in firestore.rules.
//
// The claims also have to be bound to the token's email (claimsEmail, see
// hasTrustedClaims in firestore.rules): after an account's email changes,
// revoking the old address can't reach its uid, so its claims stop counting.

service firebase.storage {
  match /b/{bucket}/o {
    // A signed-in district account whose email is verified and from a
    // trusted provider (Google, or a server-minted custom token). Mirrors
    // isFromOronoDomain / hasTrustedEmail in firestore.rules: a bare
    // `request.auth != null` would admit any account in the project
    // (anonymous, password, a self-assigned unverified email).
    function isTrustedDistrictUser() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '')
             in ['google.com', 'custom']
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@orono[.]k12[.]mn[.]us$');
    }

    function isConsoleAdmin() {
      return isTrustedDistrictUser()
        && request.auth.token.isAdmin == true
        && request.auth.token.get('claimsEmail', null) == request.auth.token.email
        && request.auth.token.role != 'administrator'
        && request.auth.token.get('demoEditBy', null) == null;
    }

    // Branding assets: district-readable, admin-writable.
    match /admin-uploads/branding/{path=**} {
      allow read: if isTrustedDistrictUser();
      allow write: if isConsoleAdmin();
    }

    // All other admin-uploads content: admin-only, read and write. A more
    // specific branding match above OR-grants auth read for that sub-path;
    // this rule governs everything else under admin-uploads/.
    match /admin-uploads/{path=**} {
      allow read: if isConsoleAdmin();
      allow write: if isConsoleAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
